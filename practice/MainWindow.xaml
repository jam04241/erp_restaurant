<Window x:Class="practice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:practice"
        mc:Ignorable="d"
        Title="Login" Height="800" Width="600"
        ResizeMode="NoResize">
    <Grid Background="#FF051821">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="600"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="500*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="LoginForm" Grid.Column="1" Background="#FF1A4645">
                <StackPanel>
                    <Rectangle x:Name="PaddingHeader" Height="50"/>
                    <StackPanel Height="500" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image MaxHeight="200" Source="/Assets/Logo.png"/>
                        <Rectangle Height="50"/>
                        <Label Content="Welcome" HorizontalAlignment="Center" FontWeight="Bold" Foreground="White"/>
                        <Rectangle Height="20"/>
                        <TextBox x:Name="txtEmail"
                                 Text="Enter Username"
                                 Width="200" Height="30"
                                 BorderThickness="0"
                                 Margin="0,5,0,5"/>
                        <PasswordBox x:Name="txtPassword"
                                     Width="200" Height="30"
                                     Margin="0,5,0,5"/>
                        <Rectangle Height="20"/>
                        <Button x:Name="LoginBtn"
                                Width="200" Height="30"
                                Content="Login"
                                Background="#FF051821"
                                Foreground="White"
                                BorderBrush="#FF051821"
                                Click="LoginBtn_Click"/>
                    </StackPanel>
                    <Rectangle x:Name="PaddingFooter" Height="50"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
